# =========================================================
# ENGINEERING MODEL FUNCTIONS
# =========================================================

UREA_MOLAR_MASS_G_PER_MOL = 60.06


def feed_urea_mass_kg(volume_liters: float, concentration_mmol_l: float) -> float:
    """
    Converts urea concentration and liquid volume into total urea mass.

    mmol/L × g/mol ÷ 1000 = g/L
    """
    grams_per_liter = (
        concentration_mmol_l * UREA_MOLAR_MASS_G_PER_MOL / 1000
    )
    return volume_liters * grams_per_liter / 1000


def extraction_efficiency(
    voltage: float,
    recovery_at_reference_voltage: float = 0.82,
    reference_voltage: float = 6.0,
) -> float:
    """
    Saturating empirical model.

    This is intentionally bounded below 100%. Replace with pilot data
    when available.
    """
    rate_constant = -np.log(
        1 - recovery_at_reference_voltage
    ) / reference_voltage

    efficiency = 1 - np.exp(-rate_constant * voltage)

    # Practical upper limit caused by membrane fouling, co-ion transport,
    # osmotic losses, and incomplete concentration.
    return float(np.clip(efficiency, 0, 0.95))


def ed_specific_energy_kwh_per_kg(
    voltage: float,
    base_energy_kwh_per_kg: float = 1.35,
    reference_voltage: float = 6.0,
) -> float:
    """
    Approximate ED electricity consumption.

    A quadratic voltage penalty represents increased current,
    resistive losses, and reduced process efficiency at high voltage.
    """
    voltage_factor = (voltage / reference_voltage) ** 2
    return base_energy_kwh_per_kg * voltage_factor


def total_unit_cost_per_ton(
    feed_urea_kg: float,
    recovered_urea_kg: float,
    energy_kwh_per_kg: float,
    electricity_price: float,
    membrane_cost_per_ton: float,
    labor_cost_per_ton: float,
    consumables_cost_per_ton: float,
) -> float:
    """Calculates production cost per metric ton of recovered urea."""
    if recovered_urea_kg <= 0:
        return np.inf

    energy_cost = (
        recovered_urea_kg
        * energy_kwh_per_kg
        * electricity_price
    )

    recovery_penalty = (
        feed_urea_kg / recovered_urea_kg
    )

    variable_cost = (
        energy_cost
        + membrane_cost_per_ton * recovery_penalty
        + labor_cost_per_ton
        + consumables_cost_per_ton
    )

    return variable_cost / (recovered_urea_kg / 1000)


def market_route(purity: float) -> tuple[str, str, str]:
    """
    Returns route, explanation, and severity level.

    Thresholds should be verified against applicable standards,
    customer specifications, and laboratory certificates.
    """
    if purity >= 99.8:
        return (
            "Automotive / DEF Candidate",
            "Potentially suitable for further qualification against applicable DEF specifications.",
            "success",
        )
    elif purity >= 99.5:
        return (
            "Industrial / Cosmetic Feedstock Candidate",
            "Requires customer-specific testing for biuret, metals, chlorides, and other contaminants.",
            "info",
        )
    else:
        return (
            "Agricultural / Industrial Grade Candidate",
            "Use only after contaminant testing and confirmation of the intended application.",
            "warning",
        )


