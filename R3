ed_energy_kwh = recovered_urea_kg * ed_energy_kwh_per_kg

electricity_cost = ed_energy_kwh * electricity_price

estimated_unit_cost = total_unit_cost_per_ton(
    feed_urea_kg=feed_urea_kg,
    recovered_urea_kg=recovered_urea_kg,
    energy_kwh_per_kg=ed_energy_kwh_per_kg,
    electricity_price=electricity_price,
    membrane_cost_per_ton=membrane_cost_per_ton,
    labor_cost_per_ton=labor_cost_per_ton,
    consumables_cost_per_ton=consumables_cost_per_ton,
)


